{
  "permissions": {
    "allow": [
      "Bash(sf project deploy validate:*)",
      "Bash(sf apex run test:*)",
      "Bash(sf project retrieve:*)",
      "Bash(python3 scripts/detect-stacks.py:*)",
      "Bash(bash scripts/verify.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git checkout -b ai/*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Read(./.env)",
      "Read(./.sfdx/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-prod-deploy.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-lint.sh" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-verify-gate.sh", "timeout": 600 }]
      }
    ]
  }
}
